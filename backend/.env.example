DJANGO_SECRET_KEY=change-me-to-a-safe-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
DJANGO_USE_SQLITE=True
MYSQL_DATABASE=kag_unity_pwa
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave EMAIL_HOST blank to print emails to the console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@church.local

# Production security hardening (backend/backend/settings.py) - only takes
# effect when DJANGO_DEBUG=False. Leave unset (0) until every domain in use
# is confirmed working over HTTPS - HSTS can't be undone early from the
# server side once a browser has cached it. See the deploy guide.
DJANGO_HSTS_SECONDS=0

# Google Identity Services ("Sign in with Google"). Same Client ID as
# frontend/.env's VITE_GOOGLE_CLIENT_ID - it's not a secret, just needs to
# match on both sides (the backend uses it to verify the token's audience).
# Leave blank to disable Google sign-in entirely (SignIn.jsx falls back to
# username/password only). Create one at https://console.cloud.google.com
# (APIs & Services > Credentials > OAuth 2.0 Client ID, type "Web
# application"), and add both yourchurch.org and your dev origin to its
# Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=

# Web Push (VAPID). Generate a matching EC P-256 key pair (public key also
# goes in frontend/.env as VITE_VAPID_PUBLIC_KEY) - e.g. via:
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; b64=lambda d: base64.urlsafe_b64encode(d).rstrip(b'=').decode(); k=ec.generate_private_key(ec.SECP256R1()); print('PUBLIC=' + b64(k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint))); print('PRIVATE=' + b64(k.private_numbers().private_value.to_bytes(32, 'big')))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
