VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Web Push VAPID public key - generate a matching pair (see backend/.env.example)
# and set this to the public half; leave blank to disable push notification opt-in.
VITE_VAPID_PUBLIC_KEY=

# Google Identity Services ("Sign in with Google") - same Client ID as
# backend/.env's GOOGLE_OAUTH_CLIENT_ID, it's not a secret. Leave blank to
# disable Google sign-in (SignIn.jsx shows an explanatory error and falls
# back to username/password).
VITE_GOOGLE_CLIENT_ID=
